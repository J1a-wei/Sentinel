# Development only. Supply actual secrets as private mounted files; never commit them.
# Set exactly one of SENTINEL_DATABASE_URL / SENTINEL_DATABASE_URL_FILE; setting both is an error.
SENTINEL_DATABASE_URL_FILE=/run/secrets/sentinel-database-url
# SENTINEL_DATABASE_URL=postgres://sentinel@127.0.0.1:5432/sentinel
SENTINEL_BIND=127.0.0.1:8080
SENTINEL_NATS_URL=nats://127.0.0.1:4222
SENTINEL_ADMIN_TOKEN_FILE=/run/secrets/sentinel-admin-token
# SENTINEL_NATS_TOKEN_FILE=/run/secrets/sentinel-nats-token
SENTINEL_WEB_DIR=web/dist
RUST_LOG=info
