# Auto probes this process's root, not the selected host/fixture root.
# Native defaults to /; container defaults to /host. Unknown requires an override.
SENTINEL_RUNTIME_MODE=auto
# Optional explicit root for fixtures or special mounts; missing paths never fall back.
# SENTINEL_HOST_ROOT=/path/to/host-view
# If auto is inconclusive on a verified native host: SENTINEL_RUNTIME_MODE=native
# Container deployments require read-only host mounts under /host.
SENTINEL_NETWORK_PROC_PREFIX=proc/1/net
# Read-only preflight (no registration or state initialization): scout doctor
SENTINEL_STATE_DIR=/var/lib/sentinel
SENTINEL_HUB_URL=http://127.0.0.1:8080
SENTINEL_NATS_URL=nats://127.0.0.1:4222
# SENTINEL_NATS_TOKEN_FILE=/run/secrets/sentinel-nats-token
SENTINEL_INTERVAL_SECONDS=30
# Only for scout enroll; remove the admin secret from the resident Scout process.
# SENTINEL_ADMIN_TOKEN_FILE=/run/secrets/sentinel-admin-token
# SENTINEL_ASSET_NAME=example-host
# SENTINEL_GROUP_ID=<uuid>
RUST_LOG=info
