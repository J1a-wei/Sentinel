# 复制为同目录 .env（已 gitignore），并填写真实值。
# secrets 文件由 scripts/make-dev-secrets.sh 生成到 deploy/secrets/。

# PostgreSQL（仅容器网络内使用，端口只发布到 127.0.0.1）
POSTGRES_PASSWORD=please-change-me

# hub 容器以该 UID/GID 运行，需与 deploy/secrets/ 文件属主一致（id -u / id -g）
HUB_UID=1000
HUB_GID=1000

# 可选端口覆盖（默认见 docker-compose.dev.yml）
#HUB_PORT=8081
#NATS_PORT=14222
#NATS_MONITOR_PORT=18222
#POSTGRES_PORT=5440

# 可选日志级别
#RUST_LOG=info
